     routes_ = dt295_routes_create();
     if (routes_ == nullptr) return;
     init_error_ = Error::OK;
+    renew_stop_.store(false, std::memory_order_release);
+    if (pthread_create(&renew_thread_, nullptr, renew_entry, this) == 0)
+        renew_joinable_ = true;
+    else
+        std::fprintf(stderr, "pix-dt295-mirakc: idle renewal thread failed to start\n");
+}
+
+/* pix-dt295-mirakc patch: the DT295 session must be renewed every 30 s (dt295_renew_if_due). Upstream only
+ * renews from pump(), i.e. while streaming, so an idle session expired after roughly 1-2 minutes:
+ * the next open failed with "card initialization requires authenticated idle state" (NO_CARD) and
+ * the device stayed in a state that only a USB power cycle cleared. Keep renewing while idle. */
+void ReceiverAdapter::renew_loop() noexcept
+{
+    std::uint64_t renewals = 0U, last_failure_log = 0U;
+    while (!renew_stop_.load(std::memory_order_acquire)) {
+        for (int i = 0; i < 10 && !renew_stop_.load(std::memory_order_acquire); ++i) {
+            const struct timespec slice{0, 100000000L};
+            nanosleep(&slice, nullptr);
+        }
+        if (renew_stop_.load(std::memory_order_acquire)) break;
+        int renewed = 0;
+        char error[256]{};
+        int failed = 0;
+        {
+            std::lock_guard<std::mutex> protocol_lock(protocol_mutex_);
+            if (device_ == nullptr || !dt295_has_session(device_)) continue;
+            failed = dt295_renew_if_due(device_, &renewed, error, sizeof(error));
+        }
+        const std::uint64_t now = clock_.monotonic_ms();
+        if (failed) {
+            if (last_failure_log == 0U || now - last_failure_log >= 60000U) {
+                std::fprintf(stderr, "pix-dt295-mirakc: session renewal failed: %s\n", error);
+                last_failure_log = now;
+            }
+        } else if (renewed && (renewals++ % 20U) == 0U) {
+            std::fprintf(stderr, "pix-dt295-mirakc: session renewed (renewal thread, #%llu)\n",
+                         static_cast<unsigned long long>(renewals));
+        }
+    }
+}
+
+void* ReceiverAdapter::renew_entry(void* opaque) noexcept
+{
+    static_cast<ReceiverAdapter*>(opaque)->renew_loop();
+    return nullptr;
+}
+
+void ReceiverAdapter::stop_renew_thread() noexcept
+{
+    renew_stop_.store(true, std::memory_order_release);
+    if (renew_joinable_) {
+        (void)pthread_join(renew_thread_, nullptr);
+        renew_joinable_ = false;
+    }
 }
 
